<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>create3_laya</name>
  <version>0.1.0</version>
  <description>
    Plain-English tasks for the iRobot Create 3 in create3_sim: a local Laya decision model
    interprets each instruction, code plans routes over the known map, and the robot drives
    them with a code (or fine-tuned Laya) driver behind a safety layer.
  </description>
  <maintainer email="lcpsyber@gmail.com">create3-laya maintainer</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>irobot_create_msgs</exec_depend>
  <exec_depend>irobot_create_gz_bringup</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
